# Página de download do Prancheta FC, fora das lojas.
AddType application/vnd.android.package-archive .apk
<FilesMatch "\.apk$">
    Header set Content-Disposition "attachment; filename=\"prancheta-fc.apk\""
    # Sem cache, para quem baixar depois receber sempre a versão nova.
    Header set Cache-Control "no-cache"
</FilesMatch>
Header set X-Robots-Tag "noindex, nofollow"
